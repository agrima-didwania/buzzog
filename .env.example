# Buzz Originals SMTP Configuration
# Configure these variables in .env.local to send live emails from hello@buzzoriginals.com

# For Google Workspace / Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=hello@buzzoriginals.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="Team Buzz Originals" <hello@buzzoriginals.com>

# For Brevo / Sendinblue:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM="Team Buzz Originals" <hello@buzzoriginals.com>

# For Zoho Mail:
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=hello@buzzoriginals.com
# SMTP_PASS=your-zoho-app-password
# SMTP_FROM="Team Buzz Originals" <hello@buzzoriginals.com>

# For Custom Domain / CPanel SMTP:
# SMTP_HOST=mail.buzzoriginals.com
# SMTP_PORT=465
# SMTP_USER=hello@buzzoriginals.com
# SMTP_PASS=your-mailbox-password
# SMTP_FROM="Team Buzz Originals" <hello@buzzoriginals.com>
